# ── Supabase (required) ──────────────────────────────────────────────
VITE_SUPABASE_URL=https://xyz.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=pub_key_here

# ── Analytics (optional) ─────────────────────────────────────────────
# Google Analytics 4 measurement ID (e.g. G-XXXXXXXXXX). Leave empty to disable.
VITE_GA_MEASUREMENT_ID=

# ── Search engine verification (optional) ────────────────────────────
# Paste the verification tokens only (content attribute value).
VITE_GOOGLE_SITE_VERIFICATION=
VITE_BING_SITE_VERIFICATION=
VITE_YANDEX_SITE_VERIFICATION=
